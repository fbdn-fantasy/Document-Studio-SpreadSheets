{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Document Studio Spreadsheets",
  "version": "1.0.0",
  "identifier": "com.forbiddenfantasy.documentstudio.spreadsheets",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Document Studio Spreadsheets",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "targets": [
      "nsis",
      "rpm",
      "deb"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "shortDescription": "Offline spreadsheet and business workbooks",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "xlsx",
          "ods"
        ],
        "name": "Spreadsheet workbook",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "update-hooks.nsh",
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../docs/THIRD-PARTY-NOTICES.md": "notices/THIRD-PARTY-NOTICES.md",
      "../docs/THIRD-PARTY-LICENSE-TEXTS.txt": "notices/THIRD-PARTY-LICENSE-TEXTS.txt",
      "../NOTICE": "NOTICE",
      "../docs/ADDITIONAL-THIRD-PARTY-NOTICES.txt": "notices/ADDITIONAL-THIRD-PARTY-NOTICES.txt"
    },
    "linux": {
      "deb": {
        "depends": [
          "curl",
          "pkexec",
          "xdg-utils",
          "libc6 (>= 2.39)",
          "libcairo2 (>= 1.10.0)",
          "libdbus-1-3 (>= 1.10)",
          "libgcc-s1 (>= 4.2)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libglib2.0-0t64 (>= 2.66.0)",
          "libgtk-3-0t64 (>= 3.21.5)",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)"
        ],
        "files": {
          "/usr/share/doc/document-studio-spreadsheets/copyright": "../LICENSE",
          "/usr/share/doc/document-studio-spreadsheets/NOTICE": "../NOTICE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/document-studio-spreadsheets/LICENSE": "../LICENSE",
          "/usr/share/licenses/document-studio-spreadsheets/NOTICE": "../NOTICE"
        },
        "depends": [
          "/usr/bin/curl",
          "polkit",
          "libc.so.6(GLIBC_2.39)(64bit)",
          "xdg-utils",
          "libcairo.so.2()(64bit)",
          "libdbus-1.so.3(LIBDBUS_1_3)(64bit)",
          "libgcc_s.so.1(GCC_4.2.0)(64bit)",
          "libgdk-3.so.0()(64bit)",
          "libgdk_pixbuf-2.0.so.0()(64bit)",
          "libgio-2.0.so.0()(64bit)",
          "libglib-2.0.so.0()(64bit)",
          "libgobject-2.0.so.0()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)"
        ]
      }
    }
  },
  "mainBinaryName": "Document-Studio-Spreadsheets-V1.0.0"
}
